<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Supermarket List</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.13.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/content/custom.css">
</head>

<body>
    <div class="content bg-dark">
        <div class="row">
            <div class="col-md-3"></div>
            <div class="col-md-6">
                <div class="d-flex flex-row mx-2 mt-4">
                    <button class="btn btn-light" type="button" onclick="newList()">
                        New list
                    </button>
                </div>
            </div>
            <div class="col-md-3"></div>
            <div class="col-md-12"></div>

            <div class="col-md-3"></div>
            <div class="col-md-6">
                {% for supermarketList in current_user.SupermarketLists %}

                <div class="card mx-2 my-5">
                    <input class="supermarket-list-info" type="hidden" name="SupermarketListId"
                        value="{{supermarketList.SupermarketListId}}">
                    <a class="btn btn-light" href="javascript:void(0);" data-bs-toggle="collapse"
                        data-bs-target="#collapse{{supermarketList.SupermarketListId}}">
                        <div class="card-header bg-transparent border-0 text-start">
                            {{supermarketList.Name}}
                        </div>
                    </a>
                    <div class="card-body p-0 collapse show" id="collapse{{supermarketList.SupermarketListId}}">
                        <table class="table table-dark m-0">
                            <thead class="text-center">
                                <th style="width: 50%;">Item</th>
                                <th style="width: 15%;">Qtd</th>
                                <th style="width: 20%;">Price</th>
                                <th style="width: 15%;">Total</th>
                            </thead>
                            <tbody>
                                {% for item in supermarketList.SupermarketItems %}
                                <tr class="item-tr">
                                    <td>
                                        <div class="d-flex position-relative">
                                            <input class="item" type="hidden" name="SupermarketItemId"
                                                value="{{item.SupermarketItemId}}">
                                            <input class="item" type="hidden" name="SupermarketListId"
                                                value="{{item.SupermarketListId}}">
                                            <input class="form-control item w-100 input-with-btn" type="text"
                                                placeholder="Item" name="Name" value="{{item.Name}}"
                                                onchange="changeItem(this)" autocomplete="off">
                                            <button class="btn btn-danger input-btn" type="button"
                                                onclick="removeItem(this)">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    </td>
                                    <td class="px-0">
                                        <input class="form-control item text-end" type="number" placeholder="Quantity"
                                            name="Quantity" value="{{item.Quantity}}" onchange="changeItem(this)" autocomplete="off">
                                    </td>
                                    <td>
                                        <input class="form-control item text-end" type="number" placeholder="Price"
                                            name="Price" value="{{item.Price}}" onchange="changeItem(this)" autocomplete="off">
                                    </td>
                                    <td class="text-center align-middle total-item-price ps-0">
                                        {{item.TotalFormatted}}
                                    </td>
                                </tr>
                                {% endfor %}
                                <tr class="new-items">
                                    <td>
                                        <input class="form-control new-item" type="text" placeholder="New Item"
                                            name="Name" autocomplete="off">
                                    </td>
                                    <td class="px-0">
                                        <input class="form-control new-item text-end" type="number"
                                            placeholder="Quantity" name="Quantity" value="1" autocomplete="off">
                                    </td>
                                    <td>
                                        <input class="form-control new-item text-end" type="number" placeholder="Price"
                                            name="Price" autocomplete="off">
                                    </td>
                                    <td class="text-start ps-0">
                                        <button class="btn btn-light w-100" type="button"
                                            onclick="newItem(this)">Add</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="card-footer text-end total-price">
                        Total: {{ supermarketList.TotalFormatted }}
                    </div>
                </div>
                {% endfor %}
            </div>
            <div class="col-md-3"></div>
        </div>
    </div>
    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p"
        crossorigin="anonymous"></script>
    <script src="/content/script.js"></script>
    <script>
        var supermarket_list_version = {{ version }};
        $(function () {
            setInterval(function () {
                checkForUpdate();
            }, {{ interval_delay }});
        });
    </script>
</body>

</html>