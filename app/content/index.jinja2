<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Supermarket List</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-1BmE4kWBq78iYhFldvKuhfTAU6auU8tT94WrHftjDbrCEXSU1oBoqyl2QvZ6jIW3" crossorigin="anonymous">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/content/custom.css">
</head>

<body>
    <div class="content">
        <!-- Header -->
        <div class="app-header">
            <div class="container-fluid">
                <div class="header-content">
                    <h1 class="header-title"><i class="fas fa-shopping-cart"></i> Shopping Lists</h1>
                    <button class="btn btn-new-list" type="button" onclick="newList()">
                        <i class="fas fa-plus"></i> New List
                    </button>
                </div>
            </div>
        </div>

        <!-- Main Content -->
        <div class="main-container">
            <div class="container-fluid">
                <div class="lists-grid">
                    {% for supermarketList in current_user.SupermarketLists %}

                    <div class="shopping-card">
                        <input class="supermarket-list-info" type="hidden" name="SupermarketListId"
                            value="{{supermarketList.SupermarketListId}}">
                        
                        <div class="card-header-modern">
                            <button class="header-toggle" type="button" data-bs-toggle="collapse"
                                data-bs-target="#collapse{{supermarketList.SupermarketListId}}">
                                <div class="header-title-section">
                                    <h2 class="list-title">{{supermarketList.Name}}</h2>
                                    <span class="item-count">{{ supermarketList.SupermarketItems|length }} items</span>
                                </div>
                                <i class="fas fa-chevron-down toggle-icon"></i>
                            </button>
                        </div>

                        <div class="card-content collapse show" id="collapse{{supermarketList.SupermarketListId}}">
                            <div class="items-container">
                                {% for item in supermarketList.SupermarketItems %}
                                <div class="item-row">
                                    <input class="item" type="hidden" name="SupermarketItemId"
                                        value="{{item.SupermarketItemId}}">
                                    <input class="item" type="hidden" name="SupermarketListId"
                                        value="{{item.SupermarketListId}}">
                                    
                                    <div class="item-name-section">
                                        <input class="form-control item-input" type="text"
                                            placeholder="Item name" name="Name" value="{{item.Name}}"
                                            onchange="changeItem(this)" autocomplete="off">
                                    </div>
                                    
                                    <div class="item-fields">
                                        <div class="field-group">
                                            <input class="form-control item-input qty-input" type="number" placeholder="Qty"
                                                name="Quantity" value="{{item.Quantity}}" onchange="changeItem(this)" autocomplete="off">
                                        </div>
                                        <div class="field-group">
                                            <input class="form-control item-input price-input" type="number" placeholder="Price"
                                                name="Price" value="{{item.Price}}" onchange="changeItem(this)" autocomplete="off">
                                        </div>
                                        <div class="field-group total-display">
                                            <span class="total-item-price">{{item.TotalFormatted}}</span>
                                        </div>
                                    </div>
                                    
                                    <button class="btn-delete" type="button"
                                        onclick="removeItem(this)" title="Delete item">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </div>
                                {% endfor %}

                                <!-- New Item Row -->
                                <div class="item-row new-items-row">
                                    <div class="item-name-section">
                                        <input class="form-control item-input new-item" type="text" placeholder="Add new item..."
                                            name="Name" autocomplete="off">
                                    </div>
                                    
                                    <div class="item-fields">
                                        <div class="field-group">
                                            <input class="form-control item-input qty-input new-item" type="number"
                                                placeholder="Qty" name="Quantity" value="1" autocomplete="off">
                                        </div>
                                        <div class="field-group">
                                            <input class="form-control item-input price-input new-item" type="number" placeholder="Price"
                                                name="Price" autocomplete="off">
                                        </div>
                                        <div class="field-group total-display">
                                            <span class="new-item-placeholder">-</span>
                                        </div>
                                    </div>
                                    
                                    <button class="btn-add" type="button"
                                        onclick="newItem(this)" title="Add item">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="card-footer-modern">
                            <span class="footer-label">Total:</span>
                            <span class="footer-total total-price">{{ supermarketList.TotalFormatted }}</span>
                        </div>
                    </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-ka7Sk0Gln4gmtz2MlQnikT1wXgYsOg+OMhuP+IlRH9sENBO0LRn5q+8nbTov4+1p"
        crossorigin="anonymous"></script>
    <script src="/content/script.js"></script>
    <script>
        var supermarket_list_version = {{ version }};
        $(function () {
            setInterval(function () {
                checkForUpdate();
            }, {{ interval_delay }});
        });
    </script>
</body>

</html>